# 敏感配置（含 API token）
settings.json

# 会话数据（可能含敏感内容）
session-env/
sessions/

# 遥测日志
telemetry/

# IDE 锁文件
ide/

# 文件历史缓存
file-history/

# Shell 快照
shell-snapshots/

# 备份
backups/

# 系统标记
.last-cleanup

# node_modules
node_modules/
mcp-servers/*/node_modules/
mcp-servers/*/package-lock.json
mcp-servers/deadloop-monitor/node_modules/
mcp-servers/deadloop-monitor/package-lock.json

# MCP 浏览器配置文件和数据
mcp-servers/ai-services/*/.chatgpt-chrome-profile*/
mcp-servers/ai-services/*/.deepseek-browser-profile*/
mcp-servers/ai-services/*/.chatgpt-mirror-profile*/
mcp-servers/ai-services/*/.chatgpt-official-profile*/
mcp-servers/ai-services/*/.claude-mirror-profile*/
mcp-servers/ai-services/.chatgpt-mirror-profile/

# 死循环监控运行时标记
mcp-servers/deadloop-monitor/.deadloop-*
.deadloop-report.md
mcp-servers/deadloop-monitor/deadloop-monitor.jsonl

# 临时工具
gh.exe

# 压缩包
mcp-servers.zip

# projects/ — 只跟踪记忆文件，忽略会话文件（jsonl 等）
projects/**/*.jsonl
projects/**/*.jsonl.pos
projects/**/subagents/
projects/**/tool-results/
*.pending_permission
.hook_debug.log

# Headroom 运行时文件
.headroom-proxy.log
.headroom-service.*.log
.headroom-service.pid
.headroom-service.log
_release.json

# Playwright test output
test-results/

# 临时文件
_tmp_*/
_chat_state.png
_page_check.png
_find_dialog.ps1

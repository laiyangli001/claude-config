# 敏感配置（含 API token）
settings.json

# 会话数据（可能含敏感内容）
session-env/
sessions/

# 遥测日志
telemetry/

# IDE 锁文件
ide/

# 文件历史缓存
file-history/

# Shell 快照
shell-snapshots/

# 备份
backups/

# 临时计划
plans/

# 系统标记
.last-cleanup

# node_modules
mcp-servers/*/node_modules/
mcp-servers/*/package-lock.json

# 压缩包
mcp-servers.zip

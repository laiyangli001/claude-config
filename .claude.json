{
  "mcpServers": {
    "claude-code-mcp-unity": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.claude\\mcp-servers\\unity-mcp\\Packages\\com.aiacats.unity-mcp\\Server~\\index.js"
      ],
      "env": {
        "MCP_UNITY_HTTP_URL": "http://localhost:8090"
      }
    },
    "chatgpt-mirror": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.claude\\mcp-servers\\ai-services\\chatgpt-mirror\\dist\\index.js"
      ]
    },
    "chatgpt-official": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.claude\\mcp-servers\\ai-services\\chatgpt-official\\dist\\index.js"
      ]
    },
    "claude-mirror": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.claude\\mcp-servers\\ai-services\\claude-mirror\\dist\\index.js"
      ]
    },
    "mineru-open-mcp": {
      "command": "uvx",
      "args": [
        "mineru-open-mcp"
      ],
      "env": {
        "MINERU_API_TOKEN": "${MINERU_API_TOKEN}"
      }
    },
    "codegraph": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.claude\\node_modules\\@colbymchenry\\codegraph\\npm-shim.js",
        "mcp"
      ]
    },
    "doubao": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "%USERPROFILE%\\.claude\\mcp-servers\\ai-services\\doubao\\dist\\index.js"
      ]
    },
    "pdf-toolkit": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@aryanbv/pdf-toolkit-mcp"
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "%USERPROFILE%\\.claude\\mcp-servers\\deadloop-monitor\\stop-hook.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "%USERPROFILE%\\.claude\\mcp-servers\\deadloop-monitor\\permission-hook.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}

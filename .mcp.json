{
  "mcpServers": {
    "deepseek": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "c:/Users/LaiYangLi/.claude/mcp-servers/mcp-deepseek/dist/index.js"
      ]
    },
    "chatgpt-mirror": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "c:/Users/LaiYangLi/.claude/mcp-servers/mcp-chatgpt-mirror/dist/index.js"
      ]
    },
    "chatgpt-official": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "c:/Users/LaiYangLi/.claude/mcp-servers/mcp-chatgpt-official/dist/index.js"
      ]
    },
    "doubao": {
      "command": "cmd",
      "args": [
        "/c",
        "node",
        "c:/Users/LaiYangLi/.claude/mcp-servers/mcp-doubao/dist/index.js"
      ]
    },
    "mineru-open-mcp": {
      "command": "uvx",
      "args": ["mineru-open-mcp"],
      "env": {
        "MINERU_API_TOKEN": "${MINERU_API_TOKEN}"
      }
    },
    "pdf-toolkit": {
      "command": "npx",
      "args": ["-y", "@aryanbv/pdf-toolkit-mcp"]
    },
    "mdmagic": {
      "command": "npx",
      "args": ["-y", "@mdmagic/mcp-server@latest"],
      "env": {
        "MDMAGIC_API_KEY": "${MDMAGIC_API_KEY}"
      }
    }
  }
}
